from machine import Pin
from utime import sleep, ticks_ms, ticks_diff
from ir_rx.nec import NEC_8
from ir_rx.print_error import print_error

# Mode switch
switch = Pin(15, Pin.IN, Pin.PULL_UP)

# RF inputs
pinA = Pin(5, Pin.IN)
pinB = Pin(4, Pin.IN)
pinC = Pin(3, Pin.IN)
pinD = Pin(2, Pin.IN)

# LEDs
ledA = Pin(18, Pin.OUT)
ledB = Pin(19, Pin.OUT)
ledC = Pin(20, Pin.OUT)
ledD = Pin(21, Pin.OUT)

# IR receiver
ir_pin = Pin(16, Pin.IN, Pin.PULL_UP)

# LED timers
timeA = 0
timeB = 0
timeC = 0
timeD = 0

# Previous RF states
lastA = 0
lastB = 0
lastC = 0
lastD = 0

# IR callback
def ir_callback(data, addr, _):
    if switch.value() == 1 and data >= 0:
        print("IR Received:", hex(data))

# Start IR receiver
ir_receiver = NEC_8(ir_pin, callback=ir_callback)
ir_receiver.error_function(print_error)

last_mode = switch.value()

while True:
    try:
        mode = switch.value()
        now = ticks_ms()

        # Check if mode changed
        if mode != last_mode:
            ledA.off()
            ledB.off()
            ledC.off()
            ledD.off()

            timeA = 0
            timeB = 0
            timeC = 0
            timeD = 0

            # Reset RF button states
            lastA = pinA.value()
            lastB = pinB.value()
            lastC = pinC.value()
            lastD = pinD.value()

            if mode == 1:
                print("IR Mode Selected")
            else:
                print("RF Mode Selected")

            last_mode = mode

        # IR MODE
        if mode == 1:
            # IR commands handled by callback
            # RF inputs are not processed
            pass

        # RF MODE
        else:
            a = pinA.value()
            b = pinB.value()
            c = pinC.value()
            d = pinD.value()

            if a == 1 and lastA == 0:
                print("RF Button A")
                ledA.on()
                timeA = now

            if b == 1 and lastB == 0:
                print("RF Button B")
                ledB.on()
                timeB = now

            if c == 1 and lastC == 0:
                print("RF Button C")
                ledC.on()
                timeC = now

            if d == 1 and lastD == 0:
                print("RF Button D")
                ledD.on()
                timeD = now

            lastA = a
            lastB = b
            lastC = c
            lastD = d

        # Turn LEDs off after 1 second
        if ledA.value() == 1 and ticks_diff(now, timeA) >= 1000:
            ledA.off()

        if ledB.value() == 1 and ticks_diff(now, timeB) >= 1000:
            ledB.off()

        if ledC.value() == 1 and ticks_diff(now, timeC) >= 1000:
            ledC.off()

        if ledD.value() == 1 and ticks_diff(now, timeD) >= 1000:
            ledD.off()

        sleep(0.02)

    except KeyboardInterrupt:
        break

# Cleanup
ir_receiver.close()

ledA.off()
ledB.off()
ledC.off()
ledD.off()

print("Finished.")
